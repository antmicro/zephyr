#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>
#include <zephyr/dt-bindings/mipi_dsi/mipi_dsi.h>

/ {
	chosen {
		zephyr,display = &ltdc;
		zephyr,console = &uart5;
		zephyr,shell-uart = &uart5;
		zephyr,flash-controller = &mt25ql01gbbb1;
	};
	aliases {
		led0 = &green_led;
		led1 = &red_led;
		led2 = &blue_led;
		sw0 = &user_button;
	};

	leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpioj 0 GPIO_ACTIVE_HIGH>;
			label = "User LD1";
			status = "okay";
		};

		red_led: led_1 {
			gpios = <&gpioj 1 GPIO_ACTIVE_HIGH>;
			label = "User LD3";
			status = "okay";
		};

		blue_led: led_2 {
			gpios = <&gpioj 2 GPIO_ACTIVE_HIGH>;
			label = "User LD4";
			status = "okay";
		};

		//Temp 
		adv7535_rst: adv7535_rst {
			gpios = <&gpiog 7 GPIO_ACTIVE_LOW>;
			status = "okay";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button {
			label = "user_button";
			gpios = <&gpioi 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			status = "okay";
		};
	};
	
	sdram1: sdram@c0000000 {
		status = "okay";
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0xc0000000 DT_SIZE_M(128)>;
		zephyr,memory-region = "SDRAM1";

		/* Frame buffer memory cache will cause screen flickering. */
		zephyr,memory-attr = <( DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE) )>;
	};
	sdram2: sdram@d0000000 {
		status = "okay";
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0xd0000000 DT_SIZE_M(128)>;
		zephyr,memory-region = "SDRAM2";

		/* Frame buffer memory cache will cause screen flickering. */
		zephyr,memory-attr = <( DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE) )>;
	};
};

&pwr {
	power-supply = "ldo";
};

&pinctrl {
	spi4_sck_pe2: spi4_sck_pe2 {
		pinmux = <STM32_PINMUX('E', 2, AF5)>;
	};

	spi4_miso_pe5: spi4_miso_pe5 {
		pinmux = <STM32_PINMUX('E', 5, AF5)>;
	};

	spi4_mosi_pe6: spi4_mosi_pe6 {
		pinmux = <STM32_PINMUX('E', 6, AF5)>;
	};
	spi5_sck_pk0: spi5_sck_pk0 {
		pinmux = <STM32_PINMUX('K', 0, AF5)>;
	}; 
	
	spi5_miso_pj11: spi5_miso_pj11 {
		pinmux = <STM32_PINMUX('J', 11, AF5)>;
	};
	
	spi5_mosi_pj10: spi5_mosi_pj10{
		pinmux = <STM32_PINMUX('J',10, AF5)>;
	};
};

&spi4 {
	status = "okay";
	pinctrl-0 = <&spi4_sck_pe2 &spi4_miso_pe5 &spi4_mosi_pe6>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;

	/*
	zephyr_uhc0: max3421e@0 {
		compatible = "maxim,max3421e-spi";
		spi-max-frequency = <26000000>;
		int-gpios = <&gpioe 3 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
		status = "okay";
		reg = <0>;
	};
	*/
};

&spi5 {
	status = "okay";
	pinctrl-0 = <&spi5_sck_pk0 &spi5_miso_pj11 &spi5_mosi_pj10>;
	pinctrl-names = "default";
	cs-gpios = <&gpiof 6 GPIO_ACTIVE_LOW>;

	zephyr_uhc0: max3421e@0 {
		compatible = "maxim,max3421e-spi";
		spi-max-frequency = <26000000>;
		int-gpios = <&gpioj 9 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpioj 8 GPIO_ACTIVE_LOW>;
		status = "okay";
		reg = <0>;
	};
};

&quadspi {
	pinctrl-0 = <&quadspi_clk_pf10 &quadspi_bk1_ncs_pg6
				 &quadspi_bk1_io0_pf8 &quadspi_bk1_io1_pf9
				 &quadspi_bk1_io2_pf7 &quadspi_bk1_io3_pd13
				 &quadspi_bk2_io0_ph2 &quadspi_bk2_io1_ph3
				 &quadspi_bk2_io2_pg9 &quadspi_bk2_io3_pg14>;
	/delete-node/ mt25ql512ab1;
	/delete-node/ mt25ql512ab2;
	
	mt25ql01gbbb1: qspi-nor-flash-1@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;
		size = <DT_SIZE_G(1)>; /* 1 Gbits */
		qspi-max-frequency = <72000000>;
		cs-high-time = <4>; /* >= 50 ns */
		spi-bus-width = <4>;
		reset-cmd;
		status = "okay";
	};

	mt25ql01gbbb2: qspi-nor-flash-2@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;
		size = <DT_SIZE_G(1)>; /* 1 Gbits */
		qspi-max-frequency = <72000000>;
		status = "okay";
	};
};

&uart5 {
	status = "okay";
	pinctrl-0 = <&uart5_tx_pb6 &uart5_rx_pb12>;
	pinctrl-names = "default";
};

&fmc {

	status = "okay";
	pinctrl-0 = <&fmc_nbl0_pe0 &fmc_nbl1_pe1 &fmc_nbl2_pi4 &fmc_nbl3_pi5
			 &fmc_sdclk_pg8 &fmc_sdnwe_pc0 &fmc_sdcke0_pc3 &fmc_sdne0_pc2 
			 &fmc_sdcke1_ph7 &fmc_sdne1_ph6 &fmc_sdnras_pf11 &fmc_sdncas_pg15
			 &fmc_a0_pf0 &fmc_a1_pf1 &fmc_a2_pf2 &fmc_a3_pf3 &fmc_a4_pf4
			 &fmc_a5_pf5 &fmc_a6_pf12 &fmc_a7_pf13 &fmc_a8_pf14
			 &fmc_a9_pf15 &fmc_a10_pg0 &fmc_a11_pg1 &fmc_a12_pg2
			 &fmc_a14_pg4 &fmc_a15_pg5 &fmc_d0_pd14 &fmc_d1_pd15
			 &fmc_d2_pd0 &fmc_d3_pd1 &fmc_d4_pe7 &fmc_d5_pe8 &fmc_d6_pe9
			 &fmc_d7_pe10 &fmc_d8_pe11 &fmc_d9_pe12 &fmc_d10_pe13
			 &fmc_d11_pe14 &fmc_d12_pe15 &fmc_d13_pd8 &fmc_d14_pd9
			 &fmc_d15_pd10 &fmc_d16_ph8 &fmc_d17_ph9 &fmc_d18_ph10
			 &fmc_d19_ph11 &fmc_d20_ph12 &fmc_d21_ph13 &fmc_d22_ph14
			 &fmc_d23_ph15 &fmc_d24_pi0 &fmc_d25_pi1 &fmc_d26_pi2
			 &fmc_d27_pi3 &fmc_d28_pi6 &fmc_d29_pi7 &fmc_d30_pi9
			 &fmc_d31_pi10>;
	pinctrl-names = "default";

	sdram {
		status = "okay";
		power-up-delay = <100>;
		num-auto-refresh = <8>;

		mode-register = <0x230>;

		refresh-rate = <603>;

		bank@0 {
			status = "okay";
			reg = <0>;

			st,sdram-control = <
				STM32_FMC_SDRAM_NC_10
				STM32_FMC_SDRAM_NR_13
				STM32_FMC_SDRAM_MWID_32
				STM32_FMC_SDRAM_NB_4
				STM32_FMC_SDRAM_CAS_3
				STM32_FMC_SDRAM_SDCLK_PERIOD_2
				STM32_FMC_SDRAM_RBURST_ENABLE
				STM32_FMC_SDRAM_RPIPE_1
			>;

			st,sdram-timing = <2 7 5 7 2 3 3>;
		};

		bank@1 {
			status = "okay";
			reg = <1>;

			st,sdram-control = <
				STM32_FMC_SDRAM_NC_10
				STM32_FMC_SDRAM_NR_13
				STM32_FMC_SDRAM_MWID_32
				STM32_FMC_SDRAM_NB_4
				STM32_FMC_SDRAM_CAS_3
				STM32_FMC_SDRAM_SDCLK_PERIOD_2
				STM32_FMC_SDRAM_RBURST_ENABLE
				STM32_FMC_SDRAM_RPIPE_1
			>;

			st,sdram-timing = <2 7 5 7 2 3 3>;
		};
	};
};

&ltdc {
  status = "disabled";
};

/* ltdc uses pll3_r as pixel clock */
&pll3 {
	status = "okay";
	clocks = <&clk_hse>;
	div-m = <5>;
	mul-n = <132>;
	div-p = <2>;
	div-q = <2>;
	div-r = <24>; /* 27.5 MHz */
};

&mipi_dsi {
	status = "okay";

	/* DSI HOST dedicated PLL
	 * F_VCO = CLK_IN / pll-idf * 2 * pll-ndiv
	 * PHI = F_VCO / 2 / (1 << pll-odf) = lane_byte_clk
	 *	   = 25 MHz / 5 * 2 * 100 / 2 / (1<<0) / 8 = 62.5 MHz
	 */
	pll-ndiv = <100>;
	pll-idf = <5>;
	pll-odf = <0>;

	vs-active-high;
	hs-active-high;
	de-active-high;

	loosely-packed;
	largest-packet-size = <64>;
	bta-ack-disable;
	test-pattern = <1>;
	nt35510: nt35510@0 {
		status = "okay";
		compatible = "frida,nt35510";
		reg = <0x0>;
		height = <800>;
		width = <480>;
		reset-gpios = <&dsi_lcd_qsh_030 57 GPIO_ACTIVE_HIGH>;
		bl-gpios = <&dsi_lcd_qsh_030 53 GPIO_ACTIVE_HIGH>;
		data-lanes = <2>;
		pixel-format = <MIPI_DSI_PIXFMT_RGB565>;
		rotation = <90>;
	};
};

&i2c4 {
	pinctrl-0 = <&i2c4_scl_pd12 &i2c4_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
	max98091: max98091@10 {
		reg = <0x10>;
		//compatible = "maxim,max98091";
		//mclk-frequency = <13000000>;
		status = "okay";
	};
	adv7535: adv7535@39 {
		reg = <0x39>;
		//compatible = "adi,adv7535";
		//reset-gpios = <&gpiog 7 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

